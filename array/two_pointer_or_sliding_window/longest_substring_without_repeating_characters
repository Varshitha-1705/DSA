//optimized solution : hashmap,two pointer,sliding window
//this as tc: O(N) ,SC: O(N)
  for(string s){
    hash[256]=-1;
    int n=s.length();
    int l=0,r=0,maxlen=0;
    while(r<n){
      if(hash[s[r]]!=-1){
        if(hash[s[r]]>=l){
          l=hash[s[r]]+1;
        }
      }
      len=r-l+1;
      maxlen=max(len,maxlen);
      hash[s[r]]=r;
      r++;
   }
  }  
  return maxlen;
