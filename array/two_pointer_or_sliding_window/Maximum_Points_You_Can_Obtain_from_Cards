//still optimmized and this runs faster and this give tc O(K),and sc O(1)

int maxScore(vector<int>& cp, int k) {
  int ans=0,ma=INT_MIN;
  for(int i=0;i<k;i++){
    ans+=cp[i];
  }
  for(int i=0;i<k;i++){
    ma=max(ans,ma);
    ans-=cp[k-1-i];
    ans+=cp[cp.size()-1-i];
  }
  ma=max(ans,ma);
  return ma;
}


