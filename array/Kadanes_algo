use on this type of problems:
  Look for keywords such as:

    Maximum subarray sum
    Largest sum contiguous subarray
    Maximum sum of consecutive elements
    Best subarray with maximum total
    Maximum profit from a continuous range

TC:O(N) ,SC O(1)

int maxSubArray(vector<int>& nums) {
        int currentSum=0;
        int maxsum=INT_MIN;
        for(int i=0;i<nums.size();i++){
            currentSum+=nums[i];
            maxsum=max(maxsum,currentSum);
            if(currentSum<0)currentSum=0;
        }
        return maxsum;
    }

Q) Maximum Product Subarray
int maxProduct(vector<int>& nums) {
        int currentMax=nums[0];
        int currentMin=nums[0];
        int maxProd=nums[0];

        for(int i=1;i<nums.size();i++){
            int tempMax=max({
                nums[i],nums[i]*currentMax,nums[i]*currentMin
            });
            int tempMin=min({
                nums[i],nums[i]*currentMax,nums[i]*currentMin
            });
            currentMax=tempMax;
            currentMin=tempMin;
            maxProd=max(maxProd,currentMax);
        }
        return maxProd;
    }
