Example 1:

Input: n = 4

Output: "1211"

Explanation:

countAndSay(1) = "1"
countAndSay(2) = RLE of "1" = "11"
countAndSay(3) = RLE of "11" = "21"
countAndSay(4) = RLE of "21" = "1211"

class Solution {
public:
    string bts(int n){
        if(n==1) return to_string(n);
        string str = bts(n-1);
        string ans = "";
        for(int i=0; i<str.size(); i++){
            int c=1;
            while(i+1<str.size() && str[i]==str[i+1]){
                i++;
                c++;
            }
            ans += to_string(c); 
            ans += str[i]; 
        }
        return ans;
        
    }
    string countAndSay(int n) {
        return bts(n);
    }
};


class Solution {
public:
    string countAndSay(int n) {
        string result = "1";
        for (int i = 1; i < n; ++i) {
            result = describe(result);
        }
        return result;
    }

private:
    string describe(const string& s) {
        string res = "";
        int count = 1;

        for (int i = 1; i < s.length(); ++i) {
            if (s[i] == s[i - 1]) {
                count++;
            } else {
                res += to_string(count) + s[i - 1];
                count = 1;
            }
        }

        res += to_string(count) + s.back();
        return res;
    }
};
