You are given an integer array nums and two integers indexDiff and valueDiff.

Find a pair of indices (i, j) such that:

i != j,
abs(i - j) <= indexDiff.
abs(nums[i] - nums[j]) <= valueDiff, and
Return true if such pair exists or false otherwise.


Example 1:

Input: nums = [1,2,3,1], indexDiff = 3, valueDiff = 0
Output: true
Explanation: We can choose (i, j) = (0, 3).
We satisfy the three conditions:
i != j --> 0 != 3
abs(i - j) <= indexDiff --> abs(0 - 3) <= 3
abs(nums[i] - nums[j]) <= valueDiff --> abs(1 - 1) <= 0

#include <bits/stdc++.h>
using namespace std;

using ll = long long;
using u32 = uint32_t;
using u64 = uint64_t;

class Solution {
    struct Flat {
        struct E {
            u32 key;
            int idx;
        };

        vector<E> h;
        u32 mask;

        static inline u32 H(u32 x) {
            x ^= x >> 16;
            x *= 0x7feb352dU;
            x ^= x >> 15;
            return x;
        }

        Flat(int cap) {
            u32 m = 8;
            while (m < (u32)cap * 2) m <<= 1;
            h.resize(m);
            mask = m - 1;
        }

        inline int get(u32 x) const {
            u32 p = H(x) & mask;

            while (h[p].idx) {
                if (h[p].key == x)
                    return h[p].idx;
                p = (p + 1) & mask;
            }

            return 0;
        }

        inline void put(u32 x, int idx) {
            u32 p = H(x) & mask;

            while (h[p].idx)
                p = (p + 1) & mask;

            h[p] = {x, idx};
        }

        inline void erase(u32 x) {
            u32 p = H(x) & mask;

            while (h[p].idx && h[p].key != x)
                p = (p + 1) & mask;

            if (!h[p].idx) return;

            u32 hole = p;
            u32 q = (p + 1) & mask;

            while (h[q].idx) {
                u32 home = H(h[q].key) & mask;

                if (((q - home) & mask) >=
                    ((hole - home) & mask)) {
                    h[hole] = h[q];
                    hole = q;
                }

                q = (q + 1) & mask;
            }

            h[hole].idx = 0;
        }
    };

    static inline u32 bias(int x) {
        return (u32)x ^ 0x80000000U;
    }

public:
    bool containsNearbyAlmostDuplicate(vector<int>& a, int k, int t) {
        int n = a.size();

        if (!k || n < 2)
            return false;

        if (k <= 8) {
            for (int i = 0; i < n; ++i) {
                int l = max(0, i - k);

                for (int j = i - 1; j >= l; --j)
                    if (llabs((ll)a[i] - a[j]) <= t)
                        return true;
            }

            return false;
        }

        int cap = min(n, k + 1);

        if (t == 0) {
            Flat mp(cap);

            for (int i = 0; i < n; ++i) {
                u32 b = bias(a[i]);

                if (mp.get(b))
                    return true;

                mp.put(b, i + 1);

                if (i >= k)
                    mp.erase(bias(a[i - k]));
            }

            return false;
        }

        const u64 w = (u64)t + 1;
        const u64 U = ((1ULL << 32) + w - 1) / w;

        auto bucket = [&](int x) -> u32 {
            return (u32)((u64)bias(x) / w);
        };

        u32 hb = 8;
        while (hb < (u32)cap * 2)
            hb <<= 1;

        if (U <= 2ULL * hb) {
            vector<int> at((size_t)U, 0);

            for (int i = 0; i < n; ++i) {
                ll x = a[i];
                u32 b = bucket(a[i]);

                int j = at[b];

                if (j)
                    return true;

                if (b) {
                    j = at[b - 1];

                    if (j && x - (ll)a[j - 1] <= t)
                        return true;
                }

                if ((u64)b + 1 < U) {
                    j = at[b + 1];

                    if (j && (ll)a[j - 1] - x <= t)
                        return true;
                }

                at[b] = i + 1;

                if (i >= k)
                    at[bucket(a[i - k])] = 0;
            }

            return false;
        }

        Flat mp(cap);

        for (int i = 0; i < n; ++i) {
            ll x = a[i];
            u32 b = bucket(a[i]);

            int j = mp.get(b);

            if (j)
                return true;

            if (b) {
                j = mp.get(b - 1);

                if (j && x - (ll)a[j - 1] <= t)
                    return true;
            }

            j = mp.get(b + 1);

            if (j && (ll)a[j - 1] - x <= t)
                return true;

            mp.put(b, i + 1);

            if (i >= k)
                mp.erase(bucket(a[i - k]));
        }

        return false;
    }
};
